    "react-dom": "^19.1.1",
    "zod": "^4.1.5",
    "@neondatabase/auth": "0.6.0-beta",
    "@neondatabase/auth-ui": "0.4.0-beta",
    "next-themes": "^0.4.6",
    "framer-motion": "^12.23.24",
    "motion": "^12.23.24",
    "recharts": "^2.15.4",
    "lightweight-charts": "^5.0.9",
    "@tanstack/react-table": "^8.21.3",
    "react-hook-form": "^7.62.0",
    "@hookform/resolvers": "^5.2.2",
    "lucide-react": "^0.468.0",
    "sonner": "^2.0.7",
