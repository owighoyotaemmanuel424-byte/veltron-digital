# API gateway
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Postgres / Prisma
DATABASE_URL=postgresql://veltron:veltron@localhost:5432/veltron?schema=public

# Redis (rate limiting + BullMQ). Leave empty to fall back to in-memory limits.
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production-please-32-bytes-min
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Telegram bot webhook
TELEGRAM_WEBHOOK_SECRET=change-me-telegram-webhook-secret

# Matching engine
ENGINE_TICK_MS=750
ENGINE_SYMBOLS=BTC:67000,ETH:3200,SOL:150
