DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"
# Required for email verification; use a verified sender/domain in Resend.
RESEND_API_KEY=""
EMAIL_FROM="Veltron Digital <verify@your-verified-domain.example>"
# Keep blank until merchant eligibility is approved and credentials are issued.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_IP_ALLOWLIST=""
# Use only for one-time protected initial admin provisioning, then remove.
ADMIN_BOOTSTRAP_TOKEN=""

# Protect the daily cleanup cron endpoint; configure the same secret in Vercel.
CRON_SECRET=""

# Neon Managed Better Auth (staged; keep disabled until identity/role mapping is tested).
NEON_AUTH_BASE_URL=""
NEXT_PUBLIC_NEON_AUTH_URL=""
NEON_AUTH_COOKIE_SECRET=""
NEON_AUTH_ENABLED="false"

# Mock catalog/order/document API contracts; keep false in production unless intentionally demoing.
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"
